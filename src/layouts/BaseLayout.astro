---
import '../index.css';
import { BookingModal } from '../components/BookingModal';
import { HeavyAuditModal } from '../components/HeavyAuditModal';

interface Props {
  title?: string;
  description?: string;
  bodyClass?: string;
}

const {
  title = "GLS. — Marketing for People Too Busy Doing the Work",
  description = "Content and messaging advisory for founders, operators, and in-house teams by Sheri Otto.",
  bodyClass = "bg-[#FFF9F3] text-[#1E2E2A] font-sans antialiased selection:bg-[#B8C87A]/40 selection:text-[#162A26] min-h-screen"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Figtree:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">
  </head>
  <body class={bodyClass}>
    <slot />
    <BookingModal client:load />
    <HeavyAuditModal client:load />

    <script is:inline>
      document.addEventListener('click', function (e) {
        var trigger = e.target && e.target.closest ? e.target.closest('[data-open-booking]') : null;
        if (trigger) {
          e.preventDefault();
          window.dispatchEvent(new CustomEvent('open-booking-modal'));
        }
      });
    </script>
  </body>
</html>
