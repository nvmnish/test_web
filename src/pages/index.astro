---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Navbar } from '../components/Navbar';
import { Hero } from '../components/Hero';
import { WhoWeServe } from '../components/WhoWeServe';
import { ClientStories } from '../components/ClientStories';
import { VideoCarousel } from '../components/VideoCarousel';
import { Pricing } from '../components/Pricing';
import { ComparisonTable } from '../components/ComparisonTable';
import { FAQSection } from '../components/FAQSection';
import { ClosingCta } from '../components/ClosingCta';
import { Footer } from '../components/Footer';
import { SectionRenderer } from '../components/SectionRenderer';
import { EmailToolPopup } from '../components/EmailToolPopup';
import { getHomePageData } from '../lib/sanity/api';

const homeData = await getHomePageData();
---

<BaseLayout
  title={homeData.seo?.title || "GLS. — Marketing for People Too Busy Doing the Work"}
  description={homeData.seo?.description || "Content and messaging advisory for founders, operators, and in-house teams by Sheri Otto."}
>
  <!-- Hero Section with overlapping transparent Navbar & Casino Counter Island -->
  <Hero client:load data={homeData.hero} />

  <!-- Main Content Sections -->
  <main>
    {homeData.sections && homeData.sections.length > 0 ? (
      <SectionRenderer client:load sections={homeData.sections} />
    ) : (
      <>
        <!-- Who We Serve: Interactive Island linking to Proof page -->
        <WhoWeServe client:load />

        <!-- Client Stories: Interactive Island triggering Book a call modal -->
        <ClientStories client:load />

        <!-- Video Carousel: Interactive Island for video preview playback -->
        <VideoCarousel client:visible />

        <!-- Who we aren't: Static comparison table -->
        <ComparisonTable />

        <!-- Pricing: Interactive Tier selection linking to booking -->
        <Pricing client:visible />

        <!-- FAQ: Interactive Accordion Island -->
        <FAQSection client:visible />

        <!-- Closing section with CTA & Modal Trigger -->
        <ClosingCta client:visible />
      </>
    )}
  </main>

  <!-- Static Footer -->
  <Footer client:load />

  <!-- Try out this free tool popup -->
  <EmailToolPopup client:load />
</BaseLayout>
