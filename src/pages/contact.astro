---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ContactPage } from '../components/ContactPage';
import { Footer } from '../components/Footer';
import { getContactPageData } from '../lib/sanity/api';

const contactData = await getContactPageData();
---

<BaseLayout
  title={contactData.seo?.title || "Work With Me — Contact GLS Advisory & Sheri Otto"}
  description={contactData.seo?.description || "Start a direct conversation with Sheri Otto on executive thought leadership, narrative matrix strategy, or the Executive Content Engine."}
  bodyClass="bg-[#FFF9F3]/60 text-[#1E2E2A] font-sans antialiased selection:bg-[#B8C87A]/40 selection:text-[#162A26] min-h-screen"
>
  <ContactPage client:load data={contactData} />
  <Footer client:load bgColor="bg-[#FFF9F3]/60" />
</BaseLayout>
