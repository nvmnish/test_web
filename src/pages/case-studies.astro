---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CaseStudiesPage } from '../components/CaseStudiesPage';
import { Footer } from '../components/Footer';
import { getCaseStudiesPageData } from '../lib/sanity/api';

const caseStudiesData = await getCaseStudiesPageData();
---

<BaseLayout
  title={caseStudiesData.seo?.title || "Case Studies & Proof — GLS. Executive Marketing Advisory"}
  description={caseStudiesData.seo?.description || "Explore real case studies showing how founders and in-house teams turned executive expertise into pipeline and enrollment."}
>
  <CaseStudiesPage client:load data={caseStudiesData} />
  <Footer client:load />
</BaseLayout>
