---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BlogPage } from '../components/BlogPage';
import { Footer } from '../components/Footer';
import { getBlogPageData, getFooterData } from '../lib/sanity/api';

const isPreview = Astro.cookies.has('sanity_preview') || Astro.url.searchParams.get('preview') === 'true';

if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
}

const blogData = await getBlogPageData({ isPreview });
const footerData = await getFooterData({ isPreview });
---

<BaseLayout
  title={blogData.seo?.title || "The GLS Journal — Marketing for Busy Leaders"}
  description={blogData.seo?.description || "Tactical essays, message teardowns, and framework breakdowns for leaders who want their expertise to match their market visibility."}
>
  {isPreview && (
    <div class="fixed top-0 left-0 right-0 z-50 bg-[#0D4049] text-white py-1.5 px-4 text-xs font-semibold flex items-center justify-between shadow-md">
      <span>Draft Preview Mode Active</span>
      <a href="/api/exit-preview" class="underline hover:text-[#BDC67A]">Exit Preview</a>
    </div>
  )}
  <BlogPage client:load data={blogData} />
  <Footer client:load data={footerData} />
</BaseLayout>
