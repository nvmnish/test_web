---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BookingPage } from '../components/BookingPage';
import { Footer } from '../components/Footer';
import { getFooterData } from '../lib/sanity/api';

const isPreview = Astro.cookies.has('sanity_preview') || Astro.url.searchParams.get('preview') === 'true';

if (isPreview) {
  Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, max-age=0');
} else {
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, must-revalidate');
}

const footerData = await getFooterData({ isPreview });
---

<BaseLayout
  title="Checkout — GLS."
  description="Select your tier, enter your bottleneck, and lock in your on-boarding discovery slot with Sheri Otto."
  bodyClass="bg-white text-[#1E2E2A] font-sans antialiased selection:bg-[#B8C87A]/40 selection:text-[#162A26] min-h-screen"
>
  {isPreview && (
    <div class="fixed top-0 left-0 right-0 z-50 bg-[#0D4049] text-white py-1.5 px-4 text-xs font-semibold flex items-center justify-between shadow-md">
      <span>Draft Preview Mode Active</span>
      <a href="/api/exit-preview" class="underline hover:text-[#BDC67A]">Exit Preview</a>
    </div>
  )}
  <!-- Interactive Form Island: Receives contact info, bottleneck details, tier selection, and appointment slot -->
  <BookingPage client:load />
  <Footer client:load bgWhite={true} data={footerData} />
</BaseLayout>
